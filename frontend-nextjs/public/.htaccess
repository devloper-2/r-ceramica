# Static-export hosting rules for the Next.js `out/` directory.
#
# `trailingSlash: true` (next.config.ts) exports every route as its own
# directory + index.html, so DirectoryIndex resolves clean URLs on its own.
#
# The previous export wrote BOTH a file `explore/tiles.html` and a directory
# `explore/tiles/` (holding the subcategory pages). Apache resolves an existing
# directory before trying <name>.html, DirectorySlash redirected /explore/tiles
# to /explore/tiles/, there was no index.html inside, and Options -Indexes
# turned that into 403 Forbidden. Same for /products/ and /orders/.

Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On

RewriteEngine On

# Legacy links to the old export's filenames (/about.html, /explore/tiles.html)
# now that those files are gone — send them to the directory form.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.html$ /$1/ [L,R=301]

# /orders/<order-number>/ is rendered on the client. Order numbers are created
# at checkout, so getStaticPaths cannot pre-render them and the export only
# contains the shell at orders/[id]/index.html. Serve that shell for any order
# URL — the page reads the id back off the URL (router.query) once the router
# is ready and fetches the order from the API. Without this, a hard load of an
# order link (reload, payment-gateway return, emailed link) 404s.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^orders/[^/]+/?$ /orders/[id]/index.html [L]

# Anything genuinely missing gets the branded page with a REAL 404 status. The
# old `RewriteRule ^ 404.html [L]` returned the 404 body under a 200, which let
# search engines index dead URLs and left the Next client router hydrating a
# /404 payload on a non-404 URL — the source of the
# "Application error: a client-side exception has occurred" screen.
ErrorDocument 404 /404.html
