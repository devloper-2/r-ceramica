# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Frontend (frontend-nextjs/)
# ---------------------------------------------------------------------------
# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js build output
.next/
out/
build/
frontend-nextjs/public/media/*
!frontend-nextjs/public/media/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# ---------------------------------------------------------------------------
# Backend (backend-codeigniter/)
# ---------------------------------------------------------------------------
# composer dependencies
vendor/

# CI4 writable (logs, cache, sessions) — keep the folder, ignore contents
backend-codeigniter/writable/cache/*
backend-codeigniter/writable/logs/*
backend-codeigniter/writable/session/*
backend-codeigniter/writable/debugbar/*
!**/.gitkeep

# admin-uploaded media (not source-controlled) — lives in public/uploads
backend-codeigniter/public/uploads/*
!backend-codeigniter/public/uploads/.gitkeep
!backend-codeigniter/public/uploads/.htaccess

# ---------------------------------------------------------------------------
# Secrets & env (both apps)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# ---------------------------------------------------------------------------
# Deploy artifacts (local build zips — not source controlled)
# ---------------------------------------------------------------------------
deploy-*.zip

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
