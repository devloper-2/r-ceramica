# WordPress Configuration
wp-config.php

# Environment files
.env
.env.local
.env.*.local

# Dependencies
vendor/
node_modules/
composer.lock

# Uploads and Media Files
wp-content/uploads/
wp-content/cache/
wp-content/backup/

# Plugins (usually installed via composer or specific management)
# Uncomment if you want to ignore all plugins except custom ones
# wp-content/plugins/*/
# But keep custom plugins with: !wp-content/plugins/your-custom-plugin/

# Themes (usually installed separately)
# Uncomment if you want to ignore default/installed themes
# wp-content/themes/*/
# But keep custom themes with: !wp-content/themes/your-custom-theme/

# WordPress upgrade temporary files
wp-content/plugins/woocommerce/
wp-content/plugins/woo-razorpay/

# Log files
*.log
debug.log

# Database files
*.db
*.sql

