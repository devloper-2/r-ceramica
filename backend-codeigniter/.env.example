#--------------------------------------------------------------------
# R Ceramica — Backend (CodeIgniter 4) environment TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit the real .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
app.allowedCorsOrigins = 'http://localhost:3000,http://localhost:8080'

#--------------------------------------------------------------------
# ENCRYPTION  (generate with: php spark key:generate)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = r_ceramica
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# APP CUSTOM — R Ceramica
#--------------------------------------------------------------------
# Read-only key required in the X-API-Key header for public /api/v1/* content.
app.contentApiKey =

# GitHub rebuild webhook (repository_dispatch)
github.repo =
github.token =
github.eventType = 'rebuild-site'

#--------------------------------------------------------------------
# RAZORPAY  — keyId is public (sent to browser); keySecret is server-only
#--------------------------------------------------------------------
razorpay.keyId =
razorpay.keySecret =
